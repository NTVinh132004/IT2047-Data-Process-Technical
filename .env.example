# Sao chép thành .env rồi đổi giá trị. Không commit .env.
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=change-me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
# Chuỗi ngẫu nhiên dùng chung cho các thành phần Airflow 3 (ký token gọi Execution API)
AIRFLOW_JWT_SECRET=change-me-to-a-long-random-string
